{
  "$defs": {
    "AttestationCost": {
      "additionalProperties": false,
      "properties": {
        "bulk_elements": {
          "minimum": 0,
          "title": "Bulk Elements",
          "type": "integer"
        },
        "category": {
          "maxLength": 64,
          "title": "Category",
          "type": "string"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "number"
        },
        "resource": {
          "default": "",
          "maxLength": 256,
          "title": "Resource",
          "type": "string"
        },
        "resources": {
          "minimum": 0,
          "title": "Resources",
          "type": "integer"
        },
        "stream_bytes": {
          "minimum": 0,
          "title": "Stream Bytes",
          "type": "integer"
        },
        "stream_items": {
          "minimum": 0,
          "title": "Stream Items",
          "type": "integer"
        }
      },
      "required": [
        "category",
        "resources",
        "stream_bytes",
        "stream_items",
        "bulk_elements",
        "elapsed_ms"
      ],
      "title": "AttestationCost",
      "type": "object"
    },
    "AttestationLimits": {
      "additionalProperties": false,
      "properties": {
        "buffer_bytes": {
          "minimum": 1,
          "title": "Buffer Bytes",
          "type": "integer"
        },
        "bulk_elements": {
          "minimum": 1,
          "title": "Bulk Elements",
          "type": "integer"
        },
        "elapsed_ms": {
          "minimum": 1,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "nesting": {
          "minimum": 1,
          "title": "Nesting",
          "type": "integer"
        },
        "resource_elapsed_ms": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Elapsed Ms"
        },
        "resources": {
          "minimum": 1,
          "title": "Resources",
          "type": "integer"
        },
        "stream_bytes": {
          "minimum": 1,
          "title": "Stream Bytes",
          "type": "integer"
        },
        "stream_items": {
          "minimum": 1,
          "title": "Stream Items",
          "type": "integer"
        }
      },
      "required": [
        "stream_bytes",
        "stream_items",
        "bulk_elements",
        "buffer_bytes",
        "resources",
        "elapsed_ms",
        "nesting"
      ],
      "title": "AttestationLimits",
      "type": "object"
    },
    "AttestationWork": {
      "additionalProperties": false,
      "description": "Bounded counters, never authored arrays or per-component payloads.",
      "properties": {
        "bulk_elements": {
          "minimum": 0,
          "title": "Bulk Elements",
          "type": "integer"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/AttestationCost"
          },
          "maxItems": 32,
          "title": "Categories",
          "type": "array"
        },
        "current_category": {
          "maxLength": 64,
          "title": "Current Category",
          "type": "string"
        },
        "current_resource": {
          "maxLength": 256,
          "title": "Current Resource",
          "type": "string"
        },
        "exceeded": {
          "anyOf": [
            {
              "enum": [
                "stream_bytes",
                "stream_items",
                "bulk_elements",
                "buffer_bytes",
                "resources",
                "elapsed_ms",
                "nesting",
                "resource_elapsed_ms"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exceeded"
        },
        "heaviest": {
          "items": {
            "$ref": "#/$defs/AttestationCost"
          },
          "maxItems": 8,
          "title": "Heaviest",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/AttestationLimits"
        },
        "peak_buffer_bytes": {
          "minimum": 0,
          "title": "Peak Buffer Bytes",
          "type": "integer"
        },
        "resources_completed": {
          "minimum": 0,
          "title": "Resources Completed",
          "type": "integer"
        },
        "stream_bytes": {
          "minimum": 0,
          "title": "Stream Bytes",
          "type": "integer"
        },
        "stream_items": {
          "minimum": 0,
          "title": "Stream Items",
          "type": "integer"
        }
      },
      "required": [
        "stream_bytes",
        "stream_items",
        "bulk_elements",
        "resources_completed",
        "peak_buffer_bytes",
        "current_category",
        "current_resource",
        "limits",
        "categories",
        "heaviest"
      ],
      "title": "AttestationWork",
      "type": "object"
    },
    "DocumentAttestation": {
      "additionalProperties": false,
      "description": "Complete means no relevant state was silently omitted by the named format.",
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Digest"
        },
        "document_session_id": {
          "$ref": "#/$defs/ResourceToken"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "number"
        },
        "file_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Sha256"
        },
        "format": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "host_session_id": {
          "$ref": "#/$defs/ResourceToken"
        },
        "omissions": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Omissions",
          "type": "array"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceToken"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_count": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Resource Count",
          "type": "integer"
        },
        "resource_scope": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Scope"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceObservation"
          },
          "maxItems": 4096,
          "title": "Resources",
          "type": "array"
        },
        "status": {
          "enum": [
            "complete",
            "unsupported",
            "limit_exceeded"
          ],
          "title": "Status",
          "type": "string"
        },
        "work": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttestationWork"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "host_session_id",
        "document_session_id",
        "project_id",
        "format",
        "digest",
        "status",
        "resource_count",
        "omissions",
        "elapsed_ms"
      ],
      "title": "DocumentAttestation",
      "type": "object"
    },
    "DocumentRestoreResult": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/DocumentAttestation"
        },
        "before": {
          "$ref": "#/$defs/DocumentAttestation"
        },
        "mutation_id": {
          "$ref": "#/$defs/ResourceToken"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "mutation_id",
        "result",
        "before",
        "after"
      ],
      "title": "DocumentRestoreResult",
      "type": "object"
    },
    "Identifier": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ProtocolError": {
      "additionalProperties": false,
      "description": "A machine-readable failure with optional application-defined details.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Identifier"
        },
        "details": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "message": {
          "$ref": "#/$defs/_NonBlankText"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ProtocolError",
      "type": "object"
    },
    "ResourceObservation": {
      "additionalProperties": false,
      "description": "Existence is not content validation; fingerprints cover declared scope only.",
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "resource_id": {
          "$ref": "#/$defs/ResourceToken"
        },
        "resource_kind": {
          "$ref": "#/$defs/ResourceToken"
        },
        "state": {
          "enum": [
            "present",
            "missing",
            "ambiguous",
            "unsupported"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "resource_kind",
        "resource_id",
        "state"
      ],
      "title": "ResourceObservation",
      "type": "object"
    },
    "ResourceToken": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "_NonBlankText": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "elapsed_seconds": {
      "default": 0,
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProtocolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "$ref": "#/$defs/ResourceToken"
    },
    "poll_after_seconds": {
      "default": 0.5,
      "maximum": 5,
      "minimum": 0.1,
      "title": "Poll After Seconds",
      "type": "number"
    },
    "progress": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentRestoreResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "state"
  ],
  "title": "DocumentRestoreJob",
  "type": "object"
}
